config {
  type: "incremental",
  database: dataform.projectConfig.vars.gold_project,
  schema: dataform.projectConfig.vars.gold_dataset,
  uniqueKey: ["order_date", "currency_code"],
  description: "Daily finance revenue mart aggregated by order date and currency.",
  bigquery: {
    partitionBy: "order_date",
    clusterBy: ["currency_code"],
    updatePartitionFilter: "order_date >= DATE_SUB(CURRENT_DATE(), INTERVAL " + cdc_helpers.lookbackDays() + " DAY)"
  },
  assertions: {
    nonNull: ["order_date", "currency_code", "gross_revenue"],
    uniqueKey: ["order_date", "currency_code"]
  },
  columns: {
    order_date: "Order calendar date.",
    currency_code: "ISO 4217 currency code.",
    order_count: "Completed order count for the day and currency.",
    gross_revenue: "Total gross order revenue.",
    discount_total: "Total discounts applied.",
    tax_total: "Total taxes collected.",
    net_revenue: "Total net revenue after discounts."
  }
}

SELECT
  order_date,
  currency_code,
  COUNT(order_id) AS order_count,
  SUM(COALESCE(gross_amount, 0)) AS gross_revenue,
  SUM(COALESCE(discount_amount, 0)) AS discount_total,
  SUM(COALESCE(tax_amount, 0)) AS tax_total,
  SUM(COALESCE(net_amount, 0)) AS net_revenue
FROM ${ref("fct_orders")}
WHERE ${when(
  incremental(),
  "order_date >= DATE_SUB(CURRENT_DATE(), INTERVAL " + cdc_helpers.lookbackDays() + " DAY)",
  "order_date >= DATE('1970-01-01')"
)}
  AND order_date IS NOT NULL
  AND currency_code IS NOT NULL
  AND COALESCE(order_status, '') != 'CANCELLED'
GROUP BY
  order_date,
  currency_code
