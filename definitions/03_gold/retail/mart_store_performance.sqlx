config {
  type: "incremental",
  database: dataform.projectConfig.vars.gold_retail_project || dataform.projectConfig.vars.gold_project,
  schema: dataform.projectConfig.vars.gold_retail_dataset || dataform.projectConfig.vars.gold_dataset,
  uniqueKey: ["order_date", "store_id", "currency_code"],
  description: "Daily retail store performance mart aggregated by date, store, and currency.",
  bigquery: {
    partitionBy: "order_date",
    clusterBy: ["store_id", "currency_code"],
    updatePartitionFilter: "order_date >= DATE_SUB(CURRENT_DATE(), INTERVAL " + cdc_helpers.lookbackDays() + " DAY)"
  },
  assertions: {
    nonNull: ["order_date", "store_id", "currency_code", "net_revenue"],
    uniqueKey: ["order_date", "store_id", "currency_code"]
  },
  columns: {
    order_date: "Order calendar date.",
    store_id: "Retail store identifier.",
    currency_code: "ISO 4217 currency code.",
    order_count: "Completed order count for the day, store, and currency.",
    unique_customers: "Distinct active customer count.",
    gross_revenue: "Total gross order revenue.",
    discount_total: "Total discounts applied.",
    tax_total: "Total taxes collected.",
    net_revenue: "Total net revenue after discounts."
  }
}

SELECT
  order_date,
  store_id,
  currency_code,
  COUNT(order_id) AS order_count,
  COUNT(DISTINCT customer_id) AS unique_customers,
  SUM(gross_amount) AS gross_revenue,
  SUM(COALESCE(discount_amount, 0)) AS discount_total,
  SUM(COALESCE(tax_amount, 0)) AS tax_total,
  SUM(net_amount) AS net_revenue
FROM ${ref("fct_orders")}
WHERE ${when(
  incremental(),
  "order_date >= DATE_SUB(CURRENT_DATE(), INTERVAL " + cdc_helpers.lookbackDays() + " DAY)",
  "order_date >= DATE('1970-01-01')"
)}
  AND order_status != 'CANCELLED'
GROUP BY
  order_date,
  store_id,
  currency_code
