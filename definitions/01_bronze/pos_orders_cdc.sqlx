config {
  type: "declaration",
  database: dataform.projectConfig.vars.bronze_project,
  schema: dataform.projectConfig.vars.bronze_dataset,
  name: "pos_orders_cdc",
  description: "Raw Datastream CDC order events landed in Bronze.",
  columns: {
    order_id: "Unique POS order identifier.",
    customer_id: "Customer identifier.",
    customer_email: "Customer email address.",
    customer_ic_number: "Customer national ID number.",
    store_id: "Retail store identifier.",
    order_status: "Order lifecycle status.",
    order_date: "Order calendar date in local store time.",
    gross_amount: "Gross order amount before discounts.",
    discount_amount: "Total discount applied to order.",
    tax_amount: "Total tax applied to order.",
    currency_code: "ISO 4217 currency code.",
    _ingested_at: "Bronze ingestion timestamp.",
    _cdc_sequence_num: "Monotonic CDC ordering sequence number.",
    _op_type: "Source write operation type.",
    _metadata_deleted: "Nullable Datastream or streaming CDC delete tombstone flag."
  }
}
